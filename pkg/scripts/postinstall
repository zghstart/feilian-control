#!/bin/bash
# 安装后修正权限、创建默认配置并启动助手。
set -e
PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

LABEL="com.feiliancontrol.helper"
DEST="/Library/PrivilegedHelperTools/feilian-control"
HELPER_PARENT="/Library/PrivilegedHelperTools"
OLD_DEST="/usr/local/libexec/feilian"
PLIST="/Library/LaunchDaemons/$LABEL.plist"
CONFIG="/Library/PrivilegedHelperTools/feilian-control/auth.conf"
OLD_CONFIG="/usr/local/etc/feilian-control.conf"
APP="/Applications/飞连控制.app"

if [[ -L "$HELPER_PARENT" || -L "$DEST" ]]; then
  echo "特权助手目录不能是符号链接：$HELPER_PARENT / $DEST" >&2
  exit 1
fi
chown root:wheel "$HELPER_PARENT" "$DEST"
chmod 755 "$HELPER_PARENT" "$DEST"
chown -R root:wheel "$DEST" /usr/local/bin/feilianctl "$PLIST"
chmod 755 "$DEST"
if [[ -d "$APP" ]]; then
  chown -R root:wheel "$APP"
fi
chmod 755 "$DEST/feilian-daemon" "$DEST/feilian-auth" "$DEST"/*.sh /usr/local/bin/feilianctl
chmod 644 "$PLIST"

if [[ -L "$CONFIG" ]] || [[ -e "$CONFIG" && ! -f "$CONFIG" ]]; then
  echo "验证配置必须是普通文件且不能是符号链接：$CONFIG" >&2
  exit 1
fi
if ! source "$DEST/auth-common.sh"; then
  echo "无法加载验证配置解析：$DEST/auth-common.sh" >&2
  exit 1
fi
new_mode="$(resolve_install_auth_mode "$CONFIG" "$OLD_CONFIG")"
printf 'AUTH_MODE=%s\n' "$new_mode" > "$CONFIG"
chown root:wheel "$CONFIG"
chmod 644 "$CONFIG"
rm -rf "$OLD_DEST"
rm -f "$OLD_CONFIG"
pkill -TERM -x FeiLianControl 2>/dev/null || true

rm -f "/var/run/$LABEL.sock"
launchctl enable "system/$LABEL"
if ! launchctl bootstrap system "$PLIST"; then
  launchctl kickstart -k "system/$LABEL"
fi

ready=false
for _ in {1..10}; do
  if helper_info="$(launchctl print "system/$LABEL" 2>/dev/null)" && \
     grep -q 'state = running' <<<"$helper_info" && \
     [[ -S "/var/run/$LABEL.sock" ]]; then
    ready=true
    break
  fi
  sleep 1
done

if [[ "$ready" != true ]]; then
  echo "飞连控制助手未能启动，请查看 /var/log/feilian-control-helper.log" >&2
  exit 1
fi

/bin/bash "$DEST/doctor.sh"
